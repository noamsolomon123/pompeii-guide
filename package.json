{
  "name": "pompeii-guide",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test bakeoff/test/*.test.js www/test/*.test.js scripts/test/*.test.js",
    "serve": "python -m http.server 8080",
    "cap:sync": "cap sync android",
    "apk:debug": "cd android && gradlew.bat assembleDebug",
    "sim": "node scripts/sim/run.mjs",
    "build:stops": "node scripts/build-stops.mjs",
    "check:stops": "node scripts/build-stops.mjs --check"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1"
  }
}
